{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus instance scraping hermetric",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "description": "Claude plan limit utilization from hermetric.",
  "uid": "claude-usage",
  "title": "Claude Usage",
  "tags": [
    "hermetric"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Session (5h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (limit, model) (claude_usage_percent{limit=\"session\"})",
          "instant": true,
          "legendFormat": "Session"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Weekly \u2014 all models",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (limit, model) (claude_usage_percent{limit=\"weekly_all\"})",
          "instant": true,
          "legendFormat": "Weekly all"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Weekly \u2014 Fable",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (limit, model) (claude_usage_percent{limit=\"weekly_model\"})",
          "instant": true,
          "legendFormat": "{{model}} weekly"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Binding limit",
      "description": "Which limit window is currently the one that will run out first.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (limit, model) (claude_usage_limit_active) == 1",
          "instant": true,
          "legendFormat": "{{limit}} {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Extra usage this month",
      "description": "Pay-per-use credits spent beyond the subscription ($100 monthly cap).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (limit, model) (claude_usage_credits_used_dollars)",
          "instant": true,
          "legendFormat": "spent"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Session resets in",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 5,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (limit, model) (claude_usage_resets_at_seconds{limit=\"session\"}) - time()",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": -1000000000000000.0,
                "to": 0,
                "result": {
                  "text": "\u2014",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Weekly resets in",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 5,
        "y": 6,
        "w": 5,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (limit, model) (claude_usage_resets_at_seconds{limit=\"weekly_all\"}) - time()",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": -1000000000000000.0,
                "to": 0,
                "result": {
                  "text": "\u2014",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Fable weekly resets in",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 10,
        "y": 6,
        "w": 5,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (limit, model) (claude_usage_resets_at_seconds{limit=\"weekly_model\"}) - time()",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": -1000000000000000.0,
                "to": 0,
                "result": {
                  "text": "\u2014",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Data age",
      "description": "Time since hermetric last fetched successfully. Polls every 3 min; red means the exporter is stuck (check its token).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 15,
        "y": 6,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (limit, model) (claude_usage_fetch_success_timestamp_seconds)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Fetch errors (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 19,
        "y": 6,
        "w": 5,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_usage_fetch_errors_total[24h]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Limit utilization over time",
      "description": "Percent of each limit window consumed, as shown on the claude.ai usage screen. Sawtooth drops are window resets. The gray dashed line is the even-pace reference: a straight burn from 0% at window start to 100% at reset. One line covers both weekly limits \u2014 they share the window, and percentages normalize away the different budgets. A session-pace series starts hidden: ctrl/cmd-click its legend entry to toggle it, and its Last value always shows where an even session burn would sit right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (limit, model) (claude_usage_percent)",
          "legendFormat": "{{limit}} {{model}}"
        },
        {
          "refId": "B",
          "expr": "clamp(100 * (time() - (max by (limit) (claude_usage_resets_at_seconds{limit=\"session\"}) - 5*3600)) / (5*3600), 0, 100)",
          "legendFormat": "session (pace)"
        },
        {
          "refId": "C",
          "expr": "clamp(100 * (time() - (max by (limit) (claude_usage_resets_at_seconds{limit=\"weekly_all\"}) - 7*24*3600)) / (7*24*3600), 0, 100)",
          "legendFormat": "weekly (pace)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": 3600000,
            "axisSoftMax": 100
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\(pace\\)$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    6
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "session (pace)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#7EB26D"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "weekly (pace)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9E9E9E"
                }
              }
            ]
          },
          {
            "__systemRef": "hideSeriesFrom",
            "matcher": {
              "id": "byNames",
              "options": {
                "mode": "exclude",
                "names": [
                  "session ",
                  "weekly_all ",
                  "weekly_model Fable",
                  "weekly (pace)"
                ],
                "prefix": "All except:",
                "readOnly": true
              }
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": false,
                  "tooltip": false
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "barchart",
      "title": "Session windows \u2014 % used",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "One bar per 5-hour session window (x = when the window started), height = peak utilization reached in it. Windows are Claude's own (they start on first use), tracked by hermetric; completed idle 5-hour stretches show as 0% bars.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "claude_session_window_peak_percent and on (window_start) (claude_session_window_start_seconds >= time() - $__range_s)",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "claude_session_window_start_seconds * 1000 and on (window_start) (claude_session_window_start_seconds >= time() - $__range_s)",
          "legendFormat": "start"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "window_start",
            "mode": "inner"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^Value #(A|B)$"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Value #B",
                "destinationType": "time"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #B": "Window start",
              "Value #A": "Used"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Window start"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 85,
            "gradientMode": "none",
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xField": "Window start",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "stacking": "none",
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 100,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}
